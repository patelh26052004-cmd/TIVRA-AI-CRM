generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String      @id @default(cuid())
  name       String
  createdAt  DateTime    @default(now())
  leads      Lead[]
  quotations Quotation[]
  users      User[]
}

model User {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  email         String    @unique
  role          Role      @default(SALESPERSON)

  jobTitle      String?

  employeeCode  String?
  phone         String?
  department    String?
  status        String    @default("ACTIVE")
  joiningDate   DateTime?
  location      String?
  notes         String?

  createdAt     DateTime  @default(now())
  passwordHash  String

  assignedLeads Lead[]    @relation("LeadOwner")
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
}

model Lead {
  id           String      @id @default(cuid())
  tenantId     String
  name         String
  company      String?
  phone        String?
  email        String?
  location     String?
  businessType String?
  product      String?
  quantity     String?
  budget       String?
  timeline     String?
  requirements String?
  source       String?
  campaign     String?
  score        Int         @default(0)
  temperature  Temperature @default(COLD)
  stage        LeadStage   @default(NEW)
  ownerId      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  owner        User?       @relation("LeadOwner", fields: [ownerId], references: [id])
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  quotations   Quotation[]
  followUps    FollowUp[]
}

model Quotation {
  id         String      @id @default(cuid())
  tenantId   String
  leadId     String
  title      String
  subtotal   Decimal
  tax        Decimal
  discount   Decimal     @default(0)
  total      Decimal
  status     QuoteStatus @default(DRAFT)
  validUntil DateTime?
  createdAt  DateTime    @default(now())
  lead       Lead        @relation(fields: [leadId], references: [id])
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
}

model FollowUp {
  id          String   @id @default(cuid())
  leadId      String
  title       String
  scheduledAt DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id])
}

model Appointment {
  id         String   @id @default(cuid())
  leadId     String
  startAt    DateTime
  endAt      DateTime
  outcome    String?
  nextAction String?
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  content   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALESPERSON
  MARKETING
  VIEWER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  DEMO
  QUOTATION
  NEGOTIATION
  WON
  LOST
}

enum Temperature {
  HOT
  WARM
  COLD
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}
